    "test:inline-overlays": "vitest run tests/features/text-commands/textCommandPolicy.test.ts tests/features/dashboard/openTaskDashboardPolicy.test.ts",
    "test:knowledge": "vitest run tests/features/knowledge/knowledgePolicy.test.ts tests/features/knowledge/knowledgeService.test.ts tests/features/knowledge/knowledgeMigrationCompatibility.test.ts",
    "version:generate": "node scripts/generate-app-version.cjs",
    "predev": "npm run version:generate",
    "pretest": "npm run version:generate && npm run source:cleanup && node scripts/ensure-node-native-deps.cjs",
    "test:version": "vitest run tests/architecture/appVersion.test.ts",
    "test:templates": "vitest run tests/features/templates/templatePolicy.test.ts",
    "test:contextual-templates": "vitest run tests/features/templates/templateContextPolicy.test.ts",
    "test:case-modals": "vitest run tests/features/cases/caseModalWorkflowPolicy.test.ts",
