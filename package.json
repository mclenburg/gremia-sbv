{
  "name": "gremia-sbv",
  "version": "0.9.8",
  "private": true,
  "description": "Offline-first Desktop-App für die vertrauliche Fallarbeit der Schwerbehindertenvertretung.",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k --success first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && npm run build:preload && node scripts/write-electron-cjs-package.cjs && electron .",
    "build": "npm run build:verify && npm run build:compile",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "dev:electron:build": "tsc -p tsconfig.electron.json && npm run build:preload && node scripts/write-electron-cjs-package.cjs",
    "deps:linux": "bash scripts/install-linux-deps.sh",
    "native:rebuild": "npm run native:rebuild:electron",
    "native:rebuild:node": "npm rebuild better-sqlite3-multiple-ciphers",
    "native:rebuild:electron": "node scripts/install-electron-app-deps.cjs",
    "native:clean": "node scripts/clean-native-build.cjs",
