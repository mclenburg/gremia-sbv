    "test:case-workbench": "vitest run tests/features/cases/caseWorkbenchWorkflowPolicy.test.ts",
    "test:template-management": "vitest run tests/features/templates/templateManagementEditDelete.test.ts",
    "test:inline-command-behavior": "vitest run tests/features/text-commands/inlineCommandBehavior.test.ts",
    "test:templates-behavior": "vitest run tests/features/templates/templatesBehavior.test.ts",
    "test:inline-command-behavior-fix": "vitest run tests/features/text-commands/inlineCommandBehavior.test.ts",
    "test:bem-migration-051b": "vitest run tests/features/bem/bemMigration.test.ts",
    "test:termination-hardening-072": "vitest run tests/features/termination/terminationHardening.test.ts tests/features/templates/terminationTemplates.test.ts",
    "test:ipc-validation-084f": "vitest run tests/architecture/ipcValidation.test.ts",
    "source:cleanup": "node scripts/cleanup-obsolete-files.cjs",
    "source:cleanup:dry-run": "node scripts/cleanup-obsolete-files.cjs --plan --verbose",
    "native:install-app-deps": "node scripts/install-electron-app-deps.cjs",
    "build:readiness": "node scripts/check-build-readiness.cjs",
    "build:readiness:strict": "node scripts/check-build-readiness.cjs --strict",
    "source:cleanup:verbose": "node scripts/cleanup-obsolete-files.cjs --verbose",
    "rc:check": "npm run version:generate && npm run source:cleanup && npm run build:readiness:strict && npm run docs:diagrams:check && node scripts/check-release-candidate-readiness.cjs",
    "dev:renderer:e2e": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "test:e2e": "node scripts/run-e2e.cjs",
    "test:e2e:ui-flows": "node scripts/run-e2e.cjs --project=ui-flows",
    "test:e2e:visual-a11y": "node scripts/run-e2e.cjs --project=visual-a11y",
    "test:e2e:isolated": "node scripts/run-e2e.cjs --project=isolated-browser --no-deps",
    "test:e2e:headed": "node scripts/run-e2e.cjs --headed",
    "test:e2e:debug": "node scripts/run-e2e.cjs --debug",
    "test:e2e:install": "node scripts/install-e2e-browsers.cjs",
    "test:e2e:docker": "docker build -f Dockerfile.e2e -t gremia-sbv-e2e . && docker run --rm gremia-sbv-e2e",
    "release:check:e2e": "npm run release:check && npm run test:e2e",
    "test:e2e:setup": "node scripts/install-e2e-tools.cjs && npm run test:e2e:install",
    "build:mac": "npm run build:verify && npm run build:compile && npm run build:package:mac",
    "build:current": "node scripts/build-current-platform.cjs",
    "build:platforms:check": "node scripts/check-build-platforms.cjs",
    "test:coverage": "vitest run --coverage",
    "test:rc-fix-case-prevention-css-090rc1d": "vitest run tests/features/cases/casePreventionCssRegressionA.test.ts",
    "test:rc-fix-case-prevention-css-090rc1e": "vitest run tests/features/cases/casePreventionCssRegressionB.test.ts",
    "test:e2e:inline-commands": "node scripts/run-e2e.cjs e2e/inline-commands.spec.ts",
    "test:rc-windows-portable-artifact-090rc1o": "vitest run tests/platform/electron/rcWindowsPortableArtifact.test.ts",
    "test:rc-final-test-sync-090rc1p": "vitest run tests/architecture/rcFinalTestSync.test.ts",
    "test:protected-persons-091": "vitest run tests/features/persons/protectedPersons.test.ts",
    "test:person-import-091": "vitest run tests/features/persons/personImport.test.ts",
    "test:person-expiry-ical-091": "vitest run tests/features/deadlines/personExpiryIcal.test.ts",
    "test:person-import-wizard-091": "vitest run tests/features/persons/personImportWizard.test.ts",
    "cleanup:obsolete-release-notes": "node scripts/cleanup-obsolete-release-notes-091.cjs",
    "test:docs-current-091": "vitest run tests/architecture/rc.test.ts",
    "docs:diagrams:check": "node scripts/check-diagram-assets.cjs",
    "css:usage:report": "node scripts/report-css-usage.cjs",
    "version:sync-lock": "node scripts/sync-package-lock-version.cjs",
    "test:e2e:visual": "node scripts/run-e2e.cjs e2e/visual-contract.spec.ts",
    "release:check:visual": "npm run build:readiness:strict && npm run test:e2e:visual",
    "test:e2e:core-ui-flows": "node scripts/run-e2e.cjs e2e/core-ui-flows.spec.ts",
    "release:check:core-ui": "npm run build:readiness:strict && npm run test:e2e:core-ui-flows",
    "test:e2e:complete-tour": "node scripts/run-e2e.cjs e2e/app-complete-tour.spec.ts",
    "release:check:complete-tour": "npm run build:readiness:strict && npm run test:e2e:complete-tour",
    "dev:electron:demo": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && npm run build:preload && node scripts/write-electron-cjs-package.cjs && electron . --demo",
    "dev:demo": "concurrently -k --success first \"npm:dev:renderer\" \"npm:dev:electron:demo\"",
    "start:demo": "npm run build && electron . --demo",
    "security:audit": "npm audit --audit-level=high",
    "licenses:generate": "node scripts/generate-third-party-licenses-fast.cjs",
    "licenses:check": "node scripts/check-third-party-licenses.cjs",
    "build:quality": "npm run security:audit && npm run licenses:check && npm run build:verify",
    "release:public-check": "npm run security:audit && npm run licenses:check && npm run release:check && npm run release:local-e2e && npm run ui:control-sweep",
    "test:e2e:a11y": "node scripts/run-e2e.cjs e2e/accessibility-axe.spec.ts",
    "release:check:a11y": "npm run build:readiness:strict && npm run test:e2e:a11y",
    "dependency:hygiene": "vitest run tests/architecture/dependencyHygiene.test.ts tests/architecture/dependencies/dependabotPolicy.test.ts tests/architecture/tailwindPostcssContract.test.ts tests/platform/electron/electronBuilderConfig.test.ts",
    "test:github-actions": "vitest run tests/architecture/githubTaggedReleaseWorkflow.test.ts tests/architecture/signpathCodeSigning.test.ts",
    "build:app": "npm run build:compile",
    "release:local-e2e": "node scripts/run-local-release-e2e.cjs",
    "ui:control-sweep": "node scripts/check-industrial-ui-control-chrome.cjs",
    "release:check:backup-restore": "npm run version:generate && tsx scripts/check-backup-restore-release.ts",
    "build:github": "node scripts/run-github-build-current-os.cjs",
    "source:cleanup:strict": "node scripts/cleanup-obsolete-files.cjs --strict-delete --verbose",
    "lint:fix": "eslint . --fix",
    "test:quality-report": "node scripts/report-test-quality.cjs",
    "test:quality-check": "node scripts/report-test-quality.cjs --check",
    "type-safety:any-report": "node scripts/report-explicit-any.cjs",
    "type-safety:any-report:json": "node scripts/report-explicit-any.cjs --json",
    "type-safety:any-check": "node scripts/report-explicit-any.cjs --check",
    "architecture:maintainability": "node scripts/report-maintainability.cjs",
    "architecture:maintainability:check": "node scripts/report-maintainability.cjs --check",
    "architecture:maintainability:baseline": "node scripts/report-maintainability.cjs --write-baseline",
    "source:cleanup:plan": "node scripts/cleanup-obsolete-files.cjs --plan --verbose",
    "build:verify": "npm run version:generate && npm run source:cleanup:strict && npm run build:readiness:strict && npm run docs:diagrams:check && npm run ipc:contracts:check && npm run test:matrix:check && npm run test:layout:check && npm run test:groups:check && npm run test:quality-check && npm run test:source-classification:check && npm run type-safety:any-check && npm run architecture:constructors:check && npm run architecture:audit-completeness:check && npm run architecture:maintainability:check && npm run lint && npm run typecheck && npm run test:coverage && npm run coverage:no-zero:check",
    "build:compile": "npm run version:generate && tsc -p tsconfig.json && vite build && npm run build:bundle:check && tsc -p tsconfig.electron.json && npm run build:preload && node scripts/write-electron-cjs-package.cjs && node scripts/build-artifact-state.cjs write",
    "build:package:linux": "node scripts/build-platform.cjs linux",
    "build:package:windows": "node scripts/build-platform.cjs win",
    "build:package:mac": "node scripts/build-platform.cjs mac",
    "test:fast": "node scripts/run-test-group.cjs fast",
    "test:integration": "node scripts/run-test-group.cjs integration",
    "test:security": "node scripts/run-test-group.cjs security",
    "test:architecture": "node scripts/run-test-group.cjs architecture",
    "test:all": "vitest run",
    "test:matrix:check": "node scripts/check-functional-coverage-matrix.cjs",
    "test:groups:check": "node scripts/check-test-suite-groups.cjs",
    "release:artifacts:linux": "node scripts/verify-release-artifacts.cjs linux",
    "release:artifacts:windows": "node scripts/verify-release-artifacts.cjs win",
    "release:smoke:linux": "node scripts/run-packaged-startup-smoke.cjs linux",
    "release:smoke:windows": "node scripts/run-packaged-startup-smoke.cjs win",
    "release:platform:linux": "npm run release:artifacts:linux && npm run release:smoke:linux && npm run release:check:backup-restore",
    "release:platform:windows": "npm run release:artifacts:windows && npm run release:smoke:windows && npm run release:check:backup-restore",
    "ipc:contracts:check": "node scripts/check-ipc-contracts.cjs",
    "build:bundle:check": "node scripts/check-renderer-bundle.cjs",
    "test:source-classification:check": "node scripts/check-source-assertion-classification.cjs",
    "build:preload": "node scripts/check-preload-source-boundary.cjs && vite build --config vite.preload.config.ts && node scripts/check-preload-bundle.cjs",
    "test:e2e:full-product": "node scripts/run-full-product-e2e.cjs",
    "test:e2e:full-product:reuse": "node scripts/run-full-product-e2e.cjs --reuse-build",
    "test:e2e:full-product:headed": "node scripts/run-full-product-e2e.cjs --reuse-build --headed",
    "test:e2e:full-product:debug": "node scripts/run-full-product-e2e.cjs --reuse-build --debug",
    "pretest:coverage": "node scripts/ensure-node-native-deps.cjs",
    "architecture:constructors:check": "node scripts/check-service-constructor-purity.cjs",
    "architecture:audit-completeness:check": "node scripts/check-personal-data-audit-completeness.cjs",
    "coverage:no-zero:check": "node scripts/check-no-zero-coverage.cjs",
    "test:layout:check": "node scripts/check-test-layout.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "argon2-browser": "^1.18.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.1",
    "fontkit": "^2.0.4",
    "ical-generator": "^11.0.0",
    "lucide-react": "^1.31.0",
    "pdfkit": "^0.19.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yauzl": "^3.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^4.3.1",
    "lightningcss": "^1.33.0",
    "pdfjs-dist": "^5.4.296",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.7",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "de.gremia.sbv",
    "productName": "Gremia.SBV",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "assets/**",
      "database/**",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_LICENSES.txt",
      "THIRD_PARTY_NOTICES.txt",
      "LICENSES/**",
      "SECURITY.md",
      "docs/**"
    ],
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "assets/icons/png",
      "syncDesktopName": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icons/icon.ico",
      "signAndEditExecutable": false
    },
    "icon": "assets/icons/icon.png",
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "database",
        "to": "database"
      }
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "author": "Gremia.SBV Contributors",
  "desktopName": "de.gremia.sbv.desktop"
}
