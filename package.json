    "build:all": "node scripts/build-current-platform.cjs",
    "debug:paths": "node -e \"console.log({cwd:process.cwd(),home:process.env.HOME,GREMIA_SBV_DATA_DIR:process.env.GREMIA_SBV_DATA_DIR})\"",
    "test:retention": "vitest run tests/privacy/retentionPolicy.test.ts",
    "release:check": "npm run build:verify && npm run release:check:backup-restore && node scripts/check-release-candidate-readiness.cjs && npm run build:compile",
    "test:privacy": "vitest run tests/privacy/contactPrivacyService.test.ts tests/privacy/reportPrivacyPolicy.test.ts tests/features/cases/documents/documentStoragePolicy.test.ts",
    "test:migrations": "vitest run tests/architecture/migrations/migrationHelpers.test.ts",
    "test:backup": "vitest run tests/security/backup/backupPolicy.test.ts",
